// Firestore Security Rules for Rafiq Al-Imam
// Deploy to Firebase Console → Firestore → Rules
//
// These rules enforce:
// 1. Only authenticated users can read/write their own user profile
// 2. User document path uses UID as document ID (users/{uid})
// 3. No user can access another user's data
// 4. Public read access is NOT allowed
// 5. Default deny all unmatched collections

rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // User profiles — each user owns their document
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    // Quran progress — per-user subcollection
    match /users/{userId}/quranProgress/{document=**} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    // Memorization (hifz) — per-user subcollection
    match /users/{userId}/hifz/{document=**} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    // Saved scenes (quick prepare) — per-user subcollection
    match /users/{userId}/scenes/{document=**} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    // User settings — per-user subcollection
    match /users/{userId}/settings/{document=**} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    // Default deny all other collections
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
